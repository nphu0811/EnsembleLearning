{
  "explorer.sortOrder": "foldersFirst",
  "explorer.compactFolders": false,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ipynb_checkpoints": true,
    "**/.venv": true,
    "**/.venv-p15-local": true,
    "**/venv": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/*_runtime": true,
    "**/runtime": true,
    ".kilo": true,
    "tmp": true,
    "README_FIRST.md": true,
    ".vscode": true
  },
  "files.associations": {
    "*.code-workspace": "jsonc"
  }
}
